# Copy to .env and replace the password before starting Compose.
COUCHDB_USER=obsidian_admin
COUCHDB_PASSWORD=REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32
COUCHDB_DATABASE=obsidiannotes
COUCHDB_VOLUME_NAME=livesync-couchdb-data
COUCHDB_VOLUME_EXTERNAL=false
COUCHDB_PORT=15984

# Required only with: docker compose --profile public up -d
# Point this domain's DNS A/AAAA records at the server first.
COUCHDB_DOMAIN=sync.example.invalid

# Backup archive retention. Set to 0 to keep all archives.
BACKUP_KEEP_DAYS=30
